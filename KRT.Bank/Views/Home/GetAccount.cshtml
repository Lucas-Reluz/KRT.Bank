<div class="container d-flex justify-content-center align-items-start" style="min-height: 80vh;">
	<div class="col-md-8">
		<h3 class="text-center mb-4">Buscar Contas</h3>

		@if (TempData["SuccessMessage"] != null)
		{
			<div class="alert alert-success alert-dismissible fade show text-center" role="alert">
				@TempData["SuccessMessage"]
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		}

		@if (TempData["ErrorMessage"] != null)
		{
			<div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
				@TempData["ErrorMessage"]
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		}

		<form method="get" asp-controller="Account" asp-action="Get">
			<div class="form-group mb-3">
				<label for="document">Documento (CPF/CNPJ)</label>
				<input type="text" id="document" name="Document" class="form-control" maxlength="18" required />
			</div>

			<div class="form-group mb-3">
				<label for="accountNumber">Número da Conta</label>
				<input type="text" id="accountNumber" name="AccountNumber" class="form-control" maxlength="12" required />
			</div>

			<button type="submit" class="btn btn-primary w-100">Buscar</button>
		</form>


		@if (ViewBag.Account != null)
		{
			<div class="card mt-4 shadow-sm">
				<div class="card-header bg-primary text-white">
					<h5 class="text-center">Informações da Conta</h5>
				</div>
				<div class="card-body">
					<p><strong>Documento:</strong> @ViewBag.Account.Document</p>
					<p><strong>Agência:</strong> @ViewBag.Account.AgencyNumber</p>
					<p><strong>Conta:</strong> @ViewBag.Account.AccountNumber</p>
					<p><strong>Limite PIX:</strong> R$ @ViewBag.Account.PixLimit</p>
				</div>
			</div>
		}
	</div>
	<script>
		document.getElementById("document").addEventListener("input", function (e) {
			let value = e.target.value.replace(/\D/g, "");

			if (value.length <= 11) {
				value = value.replace(/(\d{3})(\d)/, "$1.$2");
				value = value.replace(/(\d{3})(\d)/, "$1.$2");
				value = value.replace(/(\d{3})(\d{1,2})$/, "$1-$2");
			} else {
				value = value.replace(/^(\d{2})(\d)/, "$1.$2");
				value = value.replace(/^(\d{2})\.(\d{3})(\d)/, "$1.$2.$3");
				value = value.replace(/\.(\d{3})(\d)/, ".$1/$2");
				value = value.replace(/(\d{4})(\d{1,2})$/, "$1-$2");
			}

			e.target.value = value;
		});
	</script>

	<script>
		document.getElementById("accountNumber").addEventListener("input", function (e) {
			let value = e.target.value.replace(/\D/g, "");

			if (value.length > 1) {
				value = value.slice(0, -1) + "-" + value.slice(-1);
			}

			e.target.value = value;
		});
	</script>
</div>
